{
  "manifest_version": 3,
  "name": "MarkBase Sync",
  "version": "1.0.0",
  "description": "Keeps a live copy of your bookmarks synced to MarkBase — always watching, zero clicks.",
  "permissions": ["bookmarks", "alarms", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MarkBase Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
